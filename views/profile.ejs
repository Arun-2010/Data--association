<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10  gap-5">
        <div class="flex justify-end">
            <a class="bg-red-500 rounded-md px-3 py-2 mb-5 inline-block " href="/logout">logout</a>
        </div>
        <h3 class="text-3xl "><span>hello,</span><%=userData.name %></h3>
        <h5 class="mb-5">create your post    </h5>
        <form action="">
            <textarea placeholder="what's in your mind " class=" p-3 w-1/3 block md-3 resize-none bg-transparent border-2 border-zinc-800 rounded-md"></textarea>
            <input class="px-3 py-2 bg-blue-500 block rounded-md " type="submit" value="submit  your post">
        </form>


        <div class="posts mt-20">
            <h3 class="3xl text-zinc-400">your posts</h3>
            <div class="postcontainer mt-5   ">
                <div class="post w-1/3 p-5 border-2 border-zinc-800">
                <h4 class="text-blue-300 mb-2">@someusername</h4>
                <p class="text-sm">Lorem ipsum, dolor sit amet consectetur adipisicing elit.</p>
             </div>
            </div>
        </div>
         
    </div>
</body>
</html>