<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10  gap-5">
        <h3 class="text-center text-xl font-bold">Create Account</h3>
        <form action="/register" method="post">
            <input class="px-3 py-2 rounded-md  outline-none border-2" type="text" placeholder="name" name="name"> 
            <input class="px-3 py-2 rounded-md outline-none border-2" type="text" placeholder="username" name="username">
            <input class="px-3 py-2 rounded-md outline-none border-2" type="text" placeholder="email" name="email">
            <input class="px-3 py-2 rounded-md outline-none border-2" type="text" placeholder="password" name="password">
            <input class="px-3 py-2 rounded-md outline-none border-2" type="text" placeholder="age" name="age">
            <input  class="px-5 py-2 bg-blue-500 text-white rounded-md border-2" type="submit" value="create account">
        </form>
    </div>
</body>
</html>